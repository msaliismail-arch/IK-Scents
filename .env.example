# Modèle de configuration — copier en `.env` et remplir.
# `.env` est ignoré par git : aucun secret réel ne doit apparaître ici.

# --- Base de données (Supabase / PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Stockage des images (Supabase Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="cle-service-role-a-ne-jamais-exposer-cote-client"

# --- Authentification (NextAuth) ---
# Obligatoire. Générer une valeur unique : openssl rand -base64 32
NEXTAUTH_SECRET="a-generer"
# URL réelle du site en production (https://...)
NEXTAUTH_URL="http://localhost:3000"

# --- Compte administrateur ---
# Appliqué en base par : npm run set-admin
# Minimum 12 caractères, unique, jamais réutilisé ailleurs.
ADMIN_EMAIL="admin@exemple.ma"
ADMIN_PASSWORD="a-choisir-long-et-unique"
ADMIN_NAME="Admin ASSILL"

# --- Alertes de commande (Telegram) ---
# Facultatif : sans ces deux valeurs, le site fonctionne normalement, les
# commandes restent simplement consultables dans l'espace admin.
#
#  1. Sur Telegram, écrire à @BotFather → /newbot → il renvoie le jeton
#  2. Écrire un message à son propre bot (sinon il n'a pas le droit de
#     répondre), puis ouvrir dans un navigateur :
#     https://api.telegram.org/bot<JETON>/getUpdates
#     et relever le "chat":{"id":...} qui s'y trouve
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Traduction automatique en arabe (DeepL) ---
# Facultatif. Sans cle, les champs arabes laisses vides le restent, et le site
# affiche le texte francais aux visiteurs arabophones — rien ne casse.
# Cle gratuite : https://www.deepl.com/pro-api (500 000 caracteres / mois).
# Les cles du plan gratuit se terminent par ":fx".
DEEPL_API_KEY=""
