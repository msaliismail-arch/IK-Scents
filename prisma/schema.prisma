generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Perfume {
  id          String   @id @default(cuid())
  name        String
  description String
  image       String
  /// Marque du parfum, ex. "Lancôme". Sert à l'affichage et au tri en admin.
  brand       String   @default("")

  /// ─── Authenticité ───────────────────────────────────────────────────────
  /// Numéro de série RÉEL relevé sur le flacon d'origine dont proviennent les
  /// décants. Jamais généré automatiquement : il est saisi à la main par
  /// l'admin, flacon en main. Unique en base — deux produits ne peuvent pas
  /// porter le même numéro. `null` tant qu'aucun numéro n'a été saisi (en
  /// PostgreSQL, plusieurs NULL sont autorisés sur une colonne unique).
  serialNumber String? @unique
  /// Code de lot imprimé sous le flacon (3 à 12 caractères). C'est le seul
  /// élément que le client peut vérifier lui-même, sur un décodeur public
  /// comme CheckFresh, qui en donne la date de fabrication.
  batchCode    String  @default("")
  /// Page officielle du produit chez la marque. Doit être une URL http(s)
  /// valide, saisie et vérifiée par l'admin. Vide = pas de QR affiché.
  officialUrl  String  @default("")
  /// Famille olfactive, ex. "Boisé oriental". Vide tant que l'admin ne l'a pas saisie.
  family      String   @default("")
  /// Notes principales, ex. "Bergamote · Rose · Ambre".
  notes       String   @default("")

  /// ─── Version arabe ──────────────────────────────────────────────────────
  /// Champs facultatifs. Laissés vides, le site affiche le texte français même
  /// en arabe : mieux vaut une description en français qu'un blanc. Le nom du
  /// parfum reste souvent identique — « Sauvage » s'écrit « Sauvage » — d'où un
  /// champ séparé plutôt qu'une traduction imposée.
  nameAr        String @default("")
  descriptionAr String @default("")
  familyAr      String @default("")
  notesAr       String @default("")
  /// "disponible" | "bientot" | "rupture" — pilote l'affichage et le bouton Commander.
  availability String  @default("disponible")
  /// "homme" | "femme" | "unisexe" | "" (non précisé)
  gender      String   @default("")
  /// true = coffret / lot. S'affiche dans la section « Nos packs » au lieu de
  /// « Nos essences ». Tout le reste (prix, formats, stock) fonctionne pareil.
  isPack      Boolean  @default(false)
  published   Boolean  @default(false)
  sizes       Size[]
  /// Visuels du carrousel qui pointent vers ce parfum.
  slides      Slide[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Parfum recherché par un client, envoyé depuis « Votre parfum préféré ».
/// Sert à savoir quoi mettre en stock — ce n'est pas une commande.
model PerfumeRequest {
  id     String @id @default(cuid())
  /// Nom du parfum recherché
  name   String
  /// Ancien champ « marque », conservé pour ne pas perdre les demandes déjà
  /// enregistrées. N'est plus demandé au client.
  brand  String @default("")
  /// "homme" | "femme" | "unisexe"
  gender String @default("")
  /// Format souhaité, repris des décants définis par l'admin
  format String @default("")
  /// Nombre d'exemplaires souhaités. Renseigne le volume à commander.
  quantity Int @default(1)

  /// Coordonnées du client, pour pouvoir livrer dès que le parfum arrive
  customerName String @default("")
  phone        String
  address      String @default("")
  city         String @default("")
  postalCode   String @default("")

  /// "new" | "contacted" | "available" | "closed"
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Size {
  id        String  @id @default(cuid())
  label     String
  /// Prix catalogue, en MAD.
  price     String
  /// Prix promotionnel, en MAD. Vide = aucune promotion sur ce format.
  ///
  /// Le prix remisé est saisi tel quel, pas calculé depuis un pourcentage :
  /// « 240 » se lit d'un coup d'œil, « −20 % sur 300 » demande un calcul, et
  /// un pourcentage appliqué à plusieurs formats donne des chiffres bâtards
  /// (287, 191,20…) qu'on ne veut pas afficher en boutique.
  ///
  /// Il vit sur le format et non sur le parfum : un 5 ml et un 50 ml ne se
  /// remisent pas du même montant.
  promoPrice String @default("")
  position  Int     @default(0)
  perfumeId String
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@index([perfumeId])
}

model Order {
  id            String   @id @default(cuid())
  customerName  String
  phone         String
  address       String
  city          String?
  perfumeId     String?
  perfumeName   String
  sizeLabel     String
  price         String
  /// Copie figée des informations d'authenticité au moment de la commande.
  /// Le parfum peut être modifié ou supprimé plus tard : la commande doit
  /// garder la trace exacte du flacon d'où venait le décant livré.
  /// Aucun numéro n'est généré ici — c'est une copie, jamais une création.
  brand         String   @default("")
  serialNumber  String   @default("")
  officialUrl   String   @default("")
  quantity      Int      @default(1)
  deliveryPrice String   @default("0")
  note          String?
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

/// Annonce publiée par l'admin.
///
/// Deux points d'affichage, une seule source : la section « Annonces » de la
/// page d'accueil les montre toutes, et le bandeau en haut du site reprend la
/// première active. Écrire l'annonce une fois suffit donc à la diffuser aux
/// deux endroits — pas de texte à maintenir en double.
model Announcement {
  id String @id @default(cuid())

  /// Titre court, ex. « Nouvelle arrivée »
  title String
  /// Détail facultatif, sous le titre. Le bandeau n'affiche que le titre.
  body  String @default("")

  /// Lien facultatif. Interne ("/#collection") ou externe (https://…).
  url       String @default("")
  /// Texte du bouton quand un lien est renseigné.
  linkLabel String @default("")

  /// Version arabe. Vide = le texte français s'affiche dans les deux langues.
  titleAr     String @default("")
  bodyAr      String @default("")
  linkLabelAr String @default("")

  /// Permet de retirer une annonce sans la perdre — utile pour une promotion
  /// saisonnière qu'on réactivera l'an prochain.
  active Boolean @default(true)

  /// Ordre d'affichage. La plus petite valeur passe en premier, et c'est elle
  /// qui alimente le bandeau du haut.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

/// Visuel du carrousel affiché tout en haut de la page d'accueil.
///
/// Volontairement minimal : une image et le parfum vers lequel elle mène.
/// Aucun titre ni texte à saisir — le carrousel montre des photos, il ne
/// raconte pas ; les mots vivent dans les annonces, juste en dessous. Le texte
/// alternatif est repris du nom du parfum lié, ce qui évite un champ de plus à
/// remplir tout en gardant l'image lisible pour un lecteur d'écran.
model Slide {
  id String @id @default(cuid())

  /// Chemin de l'image, tel que renvoyé par /api/upload.
  image String

  /// Parfum vers lequel mène le clic. `null` = visuel non cliquable.
  /// `onDelete: SetNull` : supprimer un parfum ne fait pas disparaître le
  /// visuel du carrousel, il cesse simplement d'être cliquable.
  perfumeId String?
  perfume   Perfume? @relation(fields: [perfumeId], references: [id], onDelete: SetNull)

  /// Retirer un visuel de la rotation sans le supprimer.
  active Boolean @default(true)

  /// Ordre de passage. La plus petite valeur s'affiche en premier.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
  @@index([perfumeId])
}

/// Réglages du site — une seule ligne, id fixe "main".
model Settings {
  id String @id @default("main")

  /// Prix de livraison par défaut, valable partout au Maroc (en MAD, "0" = gratuit)
  deliveryPrice String @default("0")

  /// Livraison offerte à partir de ce montant de commande. Vide = désactivé.
  freeDeliveryFrom String @default("")

  /// Exceptions par ville : JSON [{ "city": "Oujda", "price": "20" }]
  deliveryCitiesJson String @default("[]")

  updatedAt DateTime @updatedAt
}
